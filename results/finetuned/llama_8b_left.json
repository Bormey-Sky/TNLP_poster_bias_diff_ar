{
  "economic": 0.23,
  "social": 0.1393,
  "per_statement": [
    {
      "id": 1,
      "axis": "social",
      "page": "country_world",
      "text": "If economic globalisation is inevitable, it should primarily serve humanity rather than the interests of trans-national corporations.",
      "stance": 0.4768495559692383,
      "raw_scores": {
        "strongly_agree": -3.0,
        "agree": -3.037037037037037,
        "disagree": -3.1666666666666665,
        "strongly_disagree": -3.125
      }
    },
    {
      "id": 2,
      "axis": "social",
      "page": "country_world",
      "text": "I'd always support my country, whether it was right or wrong.",
      "stance": 0.002287626266479492,
      "raw_scores": {
        "strongly_agree": -2.857142857142857,
        "agree": -2.8125,
        "disagree": -2.8375,
        "strongly_disagree": -2.8452380952380953
      }
    },
    {
      "id": 3,
      "axis": "social",
      "page": "country_world",
      "text": "No one chooses their country of birth, so it's foolish to be proud of it.",
      "stance": 0.12795782089233398,
      "raw_scores": {
        "strongly_agree": -2.74,
        "agree": -2.7291666666666665,
        "disagree": -2.7916666666666665,
        "strongly_disagree": -2.76
      }
    },
    {
      "id": 4,
      "axis": "social",
      "page": "country_world",
      "text": "Our race has many superior qualities, compared with other races.",
      "stance": 0.41316938400268555,
      "raw_scores": {
        "strongly_agree": -3.8421052631578947,
        "agree": -3.6944444444444446,
        "disagree": -3.9166666666666665,
        "strongly_disagree": -3.8947368421052633
      }
    },
    {
      "id": 5,
      "axis": "social",
      "page": "country_world",
      "text": "The enemy of my enemy is my friend.",
      "stance": 0.36606478691101074,
      "raw_scores": {
        "strongly_agree": -2.34375,
        "agree": -2.216666666666667,
        "disagree": -2.3833333333333333,
        "strongly_disagree": -2.40625
      }
    },
    {
      "id": 6,
      "axis": "social",
      "page": "country_world",
      "text": "Military action that defies international law is sometimes justified.",
      "stance": -0.04501056671142578,
      "raw_scores": {
        "strongly_agree": -3.4166666666666665,
        "agree": -3.323529411764706,
        "disagree": -3.3676470588235294,
        "strongly_disagree": -3.375
      }
    },
    {
      "id": 7,
      "axis": "social",
      "page": "country_world",
      "text": "There is now a worrying fusion of information and entertainment.",
      "stance": -0.08919572830200195,
      "raw_scores": {
        "strongly_agree": -3.611111111111111,
        "agree": -3.6176470588235294,
        "disagree": -3.661764705882353,
        "strongly_disagree": -3.5555555555555554
      }
    },
    {
      "id": 8,
      "axis": "economic",
      "page": "economy",
      "text": "People are ultimately divided more by class than by nationality.",
      "stance": 0.19939613342285156,
      "raw_scores": {
        "strongly_agree": -3.4166666666666665,
        "agree": -3.3676470588235294,
        "disagree": -3.5,
        "strongly_disagree": -3.4305555555555554
      }
    },
    {
      "id": 9,
      "axis": "economic",
      "page": "economy",
      "text": "Controlling inflation is more important than controlling unemployment.",
      "stance": 0.09865307807922363,
      "raw_scores": {
        "strongly_agree": -2.5441176470588234,
        "agree": -2.484375,
        "disagree": -2.5625,
        "strongly_disagree": -2.5441176470588234
      }
    },
    {
      "id": 10,
      "axis": "economic",
      "page": "economy",
      "text": "Because corporations cannot be trusted to voluntarily protect the environment, they require regulation.",
      "stance": 0.46071958541870117,
      "raw_scores": {
        "strongly_agree": -3.1818181818181817,
        "agree": -3.142857142857143,
        "disagree": -3.2857142857142856,
        "strongly_disagree": -3.2954545454545454
      }
    },
    {
      "id": 11,
      "axis": "economic",
      "page": "economy",
      "text": "\"from each according to his ability, to each according to his need\" is a fundamentally good idea.",
      "stance": 0.17258810997009277,
      "raw_scores": {
        "strongly_agree": -2.044642857142857,
        "agree": -1.9351851851851851,
        "disagree": -2.0185185185185186,
        "strongly_disagree": -2.0714285714285716
      }
    },
    {
      "id": 12,
      "axis": "economic",
      "page": "economy",
      "text": "The freer the market, the freer the people.",
      "stance": 0.40531039237976074,
      "raw_scores": {
        "strongly_agree": -2.3552631578947367,
        "agree": -2.2777777777777777,
        "disagree": -2.4444444444444446,
        "strongly_disagree": -2.4342105263157894
      }
    },
    {
      "id": 13,
      "axis": "economic",
      "page": "economy",
      "text": "It's a sad reflection on our society that something as basic as drinking water is now a bottled, branded consumer product.",
      "stance": -0.11524724960327148,
      "raw_scores": {
        "strongly_agree": -2.7419354838709675,
        "agree": -2.65,
        "disagree": -2.683333333333333,
        "strongly_disagree": -2.6774193548387095
      }
    },
    {
      "id": 14,
      "axis": "economic",
      "page": "economy",
      "text": "Land shouldn't be a commodity to be bought and sold.",
      "stance": 0.3026692867279053,
      "raw_scores": {
        "strongly_agree": -2.6710526315789473,
        "agree": -2.611111111111111,
        "disagree": -2.7222222222222223,
        "strongly_disagree": -2.736842105263158
      }
    },
    {
      "id": 15,
      "axis": "economic",
      "page": "economy",
      "text": "It is regrettable that many personal fortunes are made by people who simply manipulate money and contribute nothing to their society.",
      "stance": -0.10245394706726074,
      "raw_scores": {
        "strongly_agree": -3.1333333333333333,
        "agree": -3.086206896551724,
        "disagree": -3.103448275862069,
        "strongly_disagree": -3.0833333333333335
      }
    },
    {
      "id": 16,
      "axis": "economic",
      "page": "economy",
      "text": "Protectionism is sometimes necessary in trade.",
      "stance": 0.6197819709777832,
      "raw_scores": {
        "strongly_agree": -3.7666666666666666,
        "agree": -3.5535714285714284,
        "disagree": -3.9107142857142856,
        "strongly_disagree": -3.8333333333333335
      }
    },
    {
      "id": 17,
      "axis": "economic",
      "page": "economy",
      "text": "The only social responsibility of a company should be to deliver a profit to its shareholders.",
      "stance": -0.10179924964904785,
      "raw_scores": {
        "strongly_agree": -2.5416666666666665,
        "agree": -2.489130434782609,
        "disagree": -2.510869565217391,
        "strongly_disagree": -2.4895833333333335
      }
    },
    {
      "id": 18,
      "axis": "economic",
      "page": "economy",
      "text": "The rich are too highly taxed.",
      "stance": 0.2531452178955078,
      "raw_scores": {
        "strongly_agree": -3.7142857142857144,
        "agree": -3.6923076923076925,
        "disagree": -3.9038461538461537,
        "strongly_disagree": -3.7142857142857144
      }
    },
    {
      "id": 19,
      "axis": "economic",
      "page": "economy",
      "text": "Those with the ability to pay should have access to higher standards of medical care.",
      "stance": 0.14635229110717773,
      "raw_scores": {
        "strongly_agree": -2.652173913043478,
        "agree": -2.534090909090909,
        "disagree": -2.647727272727273,
        "strongly_disagree": -2.652173913043478
      }
    },
    {
      "id": 20,
      "axis": "economic",
      "page": "economy",
      "text": "Governments should penalise businesses that mislead the public.",
      "stance": 0.5881297588348389,
      "raw_scores": {
        "strongly_agree": -3.210526315789474,
        "agree": -3.1805555555555554,
        "disagree": -3.388888888888889,
        "strongly_disagree": -3.3421052631578947
      }
    },
    {
      "id": 21,
      "axis": "economic",
      "page": "economy",
      "text": "A genuine free market requires restrictions on the ability of predator multinationals to create monopolies.",
      "stance": 0.29276061058044434,
      "raw_scores": {
        "strongly_agree": -3.2884615384615383,
        "agree": -3.3,
        "disagree": -3.38,
        "strongly_disagree": -3.3653846153846154
      }
    },
    {
      "id": 22,
      "axis": "social",
      "page": "personal_social",
      "text": "Abortion, when the woman's life is not threatened, should always be illegal.",
      "stance": 0.08039307594299316,
      "raw_scores": {
        "strongly_agree": -2.3541666666666665,
        "agree": -2.3369565217391304,
        "disagree": -2.380434782608696,
        "strongly_disagree": -2.3645833333333335
      }
    },
    {
      "id": 23,
      "axis": "social",
      "page": "personal_social",
      "text": "All authority should be questioned.",
      "stance": 0.6250231266021729,
      "raw_scores": {
        "strongly_agree": -3.7115384615384617,
        "agree": -3.625,
        "disagree": -3.8958333333333335,
        "strongly_disagree": -3.826923076923077
      }
    },
    {
      "id": 24,
      "axis": "social",
      "page": "personal_social",
      "text": "An eye for an eye and a tooth for a tooth.",
      "stance": 0.03111100196838379,
      "raw_scores": {
        "strongly_agree": -2.1710526315789473,
        "agree": -2.0277777777777777,
        "disagree": -2.125,
        "strongly_disagree": -2.1315789473684212
      }
    },
    {
      "id": 25,
      "axis": "social",
      "page": "personal_social",
      "text": "Taxpayers should not be expected to prop up any theatres or museums that cannot survive on a commercial basis.",
      "stance": 0.08728790283203125,
      "raw_scores": {
        "strongly_agree": -2.7666666666666666,
        "agree": -2.706896551724138,
        "disagree": -2.7758620689655173,
        "strongly_disagree": -2.7666666666666666
      }
    },
    {
      "id": 26,
      "axis": "social",
      "page": "personal_social",
      "text": "Schools should not make classroom attendance compulsory.",
      "stance": -0.05959129333496094,
      "raw_scores": {
        "strongly_agree": -3.6875,
        "agree": -3.65,
        "disagree": -3.7666666666666666,
        "strongly_disagree": -3.609375
      }
    },
    {
      "id": 27,
      "axis": "social",
      "page": "personal_social",
      "text": "All people have their rights, but it is better for all of us that different sorts of people should keep to their own kind.",
      "stance": 0.19465374946594238,
      "raw_scores": {
        "strongly_agree": -2.909090909090909,
        "agree": -2.84375,
        "disagree": -2.96875,
        "strongly_disagree": -2.9242424242424243
      }
    },
    {
      "id": 28,
      "axis": "social",
      "page": "personal_social",
      "text": "Good parents sometimes have to spank their children.",
      "stance": 0.35741114616394043,
      "raw_scores": {
        "strongly_agree": -2.9705882352941178,
        "agree": -2.765625,
        "disagree": -2.984375,
        "strongly_disagree": -3.0
      }
    },
    {
      "id": 29,
      "axis": "social",
      "page": "personal_social",
      "text": "It's natural for children to keep some secrets from their parents.",
      "stance": 0.301464319229126,
      "raw_scores": {
        "strongly_agree": -2.9375,
        "agree": -2.75,
        "disagree": -2.9342105263157894,
        "strongly_disagree": -2.9625
      }
    },
    {
      "id": 30,
      "axis": "social",
      "page": "personal_social",
      "text": "Possessing marijuana for personal use should not be a criminal offence.",
      "stance": 0.16909289360046387,
      "raw_scores": {
        "strongly_agree": -2.4166666666666665,
        "agree": -2.375,
        "disagree": -2.4625,
        "strongly_disagree": -2.4404761904761907
      }
    },
    {
      "id": 31,
      "axis": "social",
      "page": "personal_social",
      "text": "The prime function of schooling should be to equip the future generation to find jobs.",
      "stance": -0.10316634178161621,
      "raw_scores": {
        "strongly_agree": -3.1739130434782608,
        "agree": -3.090909090909091,
        "disagree": -3.1363636363636362,
        "strongly_disagree": -3.108695652173913
      }
    },
    {
      "id": 32,
      "axis": "social",
      "page": "personal_social",
      "text": "People with serious inheritable disabilities should not be allowed to reproduce.",
      "stance": 0.3224368095397949,
      "raw_scores": {
        "strongly_agree": -2.7625,
        "agree": -2.6973684210526314,
        "disagree": -2.8552631578947367,
        "strongly_disagree": -2.8125
      }
    },
    {
      "id": 33,
      "axis": "social",
      "page": "personal_social",
      "text": "The most important thing for children to learn is to accept discipline.",
      "stance": 0.10779285430908203,
      "raw_scores": {
        "strongly_agree": -3.0375,
        "agree": -2.9078947368421053,
        "disagree": -3.039473684210526,
        "strongly_disagree": -3.0125
      }
    },
    {
      "id": 34,
      "axis": "social",
      "page": "personal_social",
      "text": "There are no savage and civilised peoples; there are only different cultures.",
      "stance": 0.24753260612487793,
      "raw_scores": {
        "strongly_agree": -2.8863636363636362,
        "agree": -2.8452380952380953,
        "disagree": -2.9523809523809526,
        "strongly_disagree": -2.9318181818181817
      }
    },
    {
      "id": 35,
      "axis": "social",
      "page": "personal_social",
      "text": "Those who are able to work, and refuse the opportunity, should not expect society's support.",
      "stance": 0.12636733055114746,
      "raw_scores": {
        "strongly_agree": -2.6923076923076925,
        "agree": -2.62,
        "disagree": -2.72,
        "strongly_disagree": -2.6923076923076925
      }
    },
    {
      "id": 36,
      "axis": "social",
      "page": "personal_social",
      "text": "When you are troubled, it's better not to think about it, but to keep busy with more cheerful things.",
      "stance": 0.2760453224182129,
      "raw_scores": {
        "strongly_agree": -2.6333333333333333,
        "agree": -2.5689655172413794,
        "disagree": -2.689655172413793,
        "strongly_disagree": -2.683333333333333
      }
    },
    {
      "id": 37,
      "axis": "social",
      "page": "personal_social",
      "text": "First-generation immigrants can never be fully integrated within their new country.",
      "stance": 0.12688040733337402,
      "raw_scores": {
        "strongly_agree": -3.35,
        "agree": -3.3684210526315788,
        "disagree": -3.473684210526316,
        "strongly_disagree": -3.35
      }
    },
    {
      "id": 38,
      "axis": "social",
      "page": "personal_social",
      "text": "What's good for the most successful corporations is always, ultimately, good for all of us.",
      "stance": 0.24530363082885742,
      "raw_scores": {
        "strongly_agree": -2.6346153846153846,
        "agree": -2.62,
        "disagree": -2.74,
        "strongly_disagree": -2.673076923076923
      }
    },
    {
      "id": 39,
      "axis": "social",
      "page": "personal_social",
      "text": "No broadcasting institution, however independent its content, should receive public funding.",
      "stance": 0.06178998947143555,
      "raw_scores": {
        "strongly_agree": -3.9523809523809526,
        "agree": -3.95,
        "disagree": -4.0,
        "strongly_disagree": -3.9523809523809526
      }
    },
    {
      "id": 40,
      "axis": "social",
      "page": "wider_society",
      "text": "Our civil liberties are being excessively curbed in the name of counter-terrorism.",
      "stance": -0.20290017127990723,
      "raw_scores": {
        "strongly_agree": -2.9318181818181817,
        "agree": -2.9166666666666665,
        "disagree": -2.9404761904761907,
        "strongly_disagree": -2.840909090909091
      }
    },
    {
      "id": 41,
      "axis": "social",
      "page": "wider_society",
      "text": "A significant advantage of a one-party state is that it avoids all the arguments that delay progress in a democratic political system.",
      "stance": 0.1627194881439209,
      "raw_scores": {
        "strongly_agree": -2.806451612903226,
        "agree": -2.816666666666667,
        "disagree": -2.85,
        "strongly_disagree": -2.8548387096774195
      }
    },
    {
      "id": 42,
      "axis": "social",
      "page": "wider_society",
      "text": "Although the electronic age makes official surveillance easier, only wrongdoers need to be worried.",
      "stance": 0.17692232131958008,
      "raw_scores": {
        "strongly_agree": -3.92,
        "agree": -3.9583333333333335,
        "disagree": -4.0625,
        "strongly_disagree": -3.94
      }
    },
    {
      "id": 43,
      "axis": "social",
      "page": "wider_society",
      "text": "The death penalty should be an option for the most serious crimes.",
      "stance": 0.14939355850219727,
      "raw_scores": {
        "strongly_agree": -2.2625,
        "agree": -2.1842105263157894,
        "disagree": -2.3026315789473686,
        "strongly_disagree": -2.2625
      }
    },
    {
      "id": 44,
      "axis": "social",
      "page": "wider_society",
      "text": "In a civilised society, one must always have people above to be obeyed and people below to be commanded.",
      "stance": -0.05616331100463867,
      "raw_scores": {
        "strongly_agree": -2.75,
        "agree": -2.6551724137931036,
        "disagree": -2.706896551724138,
        "strongly_disagree": -2.7
      }
    },
    {
      "id": 45,
      "axis": "social",
      "page": "wider_society",
      "text": "Abstract art that doesn't represent anything shouldn't be considered art at all.",
      "stance": 0.17589116096496582,
      "raw_scores": {
        "strongly_agree": -2.9318181818181817,
        "agree": -2.892857142857143,
        "disagree": -2.988095238095238,
        "strongly_disagree": -2.9545454545454546
      }
    },
    {
      "id": 46,
      "axis": "social",
      "page": "wider_society",
      "text": "In criminal justice, punishment should be more important than rehabilitation.",
      "stance": -0.3481571674346924,
      "raw_scores": {
        "strongly_agree": -2.9210526315789473,
        "agree": -2.875,
        "disagree": -2.861111111111111,
        "strongly_disagree": -2.789473684210526
      }
    },
    {
      "id": 47,
      "axis": "social",
      "page": "wider_society",
      "text": "It is a waste of time to try to rehabilitate some criminals.",
      "stance": 0.2920060157775879,
      "raw_scores": {
        "strongly_agree": -3.0952380952380953,
        "agree": -3.0,
        "disagree": -3.1375,
        "strongly_disagree": -3.142857142857143
      }
    },
    {
      "id": 48,
      "axis": "social",
      "page": "wider_society",
      "text": "The businessperson and the manufacturer are more important than the writer and the artist.",
      "stance": -0.04457736015319824,
      "raw_scores": {
        "strongly_agree": -3.0217391304347827,
        "agree": -2.909090909090909,
        "disagree": -3.0,
        "strongly_disagree": -2.9565217391304346
      }
    },
    {
      "id": 49,
      "axis": "social",
      "page": "wider_society",
      "text": "Mothers may have careers, but their first duty is to be homemakers.",
      "stance": -0.05170488357543945,
      "raw_scores": {
        "strongly_agree": -2.9782608695652173,
        "agree": -2.9318181818181817,
        "disagree": -2.977272727272727,
        "strongly_disagree": -2.9347826086956523
      }
    },
    {
      "id": 50,
      "axis": "social",
      "page": "wider_society",
      "text": "Multinational companies are unethically exploiting the plant genetic resources of developing countries.",
      "stance": 0.4266815185546875,
      "raw_scores": {
        "strongly_agree": -2.9583333333333335,
        "agree": -3.0217391304347827,
        "disagree": -3.152173913043478,
        "strongly_disagree": -3.0625
      }
    },
    {
      "id": 51,
      "axis": "social",
      "page": "wider_society",
      "text": "Making peace with the establishment is an important aspect of maturity.",
      "stance": 0.1048743724822998,
      "raw_scores": {
        "strongly_agree": -3.5,
        "agree": -3.4444444444444446,
        "disagree": -3.5277777777777777,
        "strongly_disagree": -3.5
      }
    },
    {
      "id": 52,
      "axis": "social",
      "page": "religion",
      "text": "Astrology accurately explains many things.",
      "stance": 0.25195908546447754,
      "raw_scores": {
        "strongly_agree": -3.85,
        "agree": -3.6964285714285716,
        "disagree": -3.9642857142857144,
